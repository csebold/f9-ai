<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ChatClient.ViewModels"
        mc:Ignorable="d"
        x:Class="ChatClient.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Settings"
        Width="480"
        Height="600"
        CanResize="True"
        WindowStartupLocation="CenterOwner">
  <ScrollViewer>
    <StackPanel Margin="16" Spacing="12">
      <TextBlock Text="Provider" FontWeight="Bold"/>
      <ComboBox ItemsSource="{Binding Providers}"
                SelectedItem="{Binding SelectedProviderOption}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:SettingsViewModel+ProviderOption">
            <TextBlock Text="{Binding DisplayName}"/>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <Separator/>

      <StackPanel Spacing="8">
        <TextBlock Text="OpenAI API Key"/>
        <TextBox Text="{Binding OpenAiApiKey}" Watermark="sk-..." />
      </StackPanel>

      <StackPanel Spacing="8">
        <TextBlock Text="Anthropic API Key"/>
        <TextBox Text="{Binding AnthropicApiKey}" Watermark="sk-ant-..." />
      </StackPanel>

      <StackPanel Spacing="8">
        <TextBlock Text="OpenRouter API Key"/>
        <TextBox Text="{Binding OpenRouterApiKey}" Watermark="org-..." />
      </StackPanel>

      <StackPanel Spacing="8">
        <TextBlock Text="Ollama Endpoint"/>
        <TextBox Text="{Binding OllamaEndpoint}" Watermark="http://localhost:11434/" />
      </StackPanel>

      <Separator/>

      <TextBlock Text="Model" FontWeight="Bold"/>
      <WrapPanel ItemSpacing="8" VerticalAlignment="Center">
        <ComboBox Width="300"
                  ItemsSource="{Binding AvailableModelOptions}"
                  SelectedItem="{Binding SelectedModelOption}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:SettingsViewModel+ModelOption">
              <TextBlock Text="{Binding DisplayName}"/>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <CheckBox Content="Recommended only"
                  IsChecked="{Binding ShowOnlyRecommendedModels}"
                  VerticalAlignment="Center"/>
        <Button Content="Refresh"
                Command="{Binding FetchModelsCommand}"/>
        <Button Content="Download"
                Command="{Binding DownloadModelCommand}"/>
      </WrapPanel>

      <ProgressBar IsIndeterminate="True"
                   IsVisible="{Binding IsBusy}"
                   Height="4"/>

      <Separator/>

      <StackPanel Spacing="8">
        <TextBlock Text="Chat Input"
                   FontWeight="Bold"/>
        <StackPanel Spacing="4">
          <TextBlock Text="Send shortcut"/>
          <ComboBox ItemsSource="{Binding SendActivationOptions}"
                    SelectedItem="{Binding SelectedSendActivationOption}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:SettingsViewModel+SendActivationOption">
                <TextBlock Text="{Binding DisplayName}"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
      </StackPanel>

      <Separator/>

      <StackPanel Spacing="12">
        <TextBlock Text="Session Persistence"
                   FontWeight="Bold"/>
        <CheckBox Content="Enable session persistence"
                  IsChecked="{Binding EnableSessionPersistence}"/>
        <Grid ColumnDefinitions="*,Auto"
              RowDefinitions="Auto,Auto"
              ColumnSpacing="12"
              RowSpacing="8">
          <TextBlock Grid.Row="0"
                     Grid.Column="0"
                     Text="Max sessions per project"
                     VerticalAlignment="Center"/>
          <NumericUpDown Grid.Row="0"
                         Grid.Column="1"
                         Minimum="1"
                         Maximum="100"
                         FormatString="0"
                         Width="120"
                         Value="{Binding MaxSessionsPerProject}"/>
          <TextBlock Grid.Row="1"
                     Grid.Column="0"
                     Text="Max messages per session"
                     VerticalAlignment="Center"/>
          <NumericUpDown Grid.Row="1"
                         Grid.Column="1"
                         Minimum="1"
                         Maximum="5000"
                         FormatString="0"
                         Width="120"
                         Value="{Binding MaxMessagesPerSession}"/>
        </Grid>
        <Button Content="Purge Stored Chats"
                Command="{Binding PurgeChatsCommand}"
                HorizontalAlignment="Left"/>
      </StackPanel>

      <TextBlock Text="{Binding StatusMessage}"
                 Foreground="Gray"
                 TextWrapping="Wrap"/>

      <StackPanel Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Spacing="8"
                  Margin="0,16,0,0">
        <Button Content="Cancel"
                Command="{Binding CancelCommand}"/>
        <Button Content="Save"
                Command="{Binding SaveCommand}"/>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
