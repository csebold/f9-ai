<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ChatClient.ViewModels"
        xmlns:model="using:ChatClient.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:ChatClient.Views"
        mc:Ignorable="d"
        d:DesignWidth="1120"
        d:DesignHeight="720"
        x:Class="ChatClient.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        xmlns:conv="using:ChatClient.Converters"
        Icon="/Assets/avalonia-logo.ico"
        Title="Foundry-9 AI">

  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="ConversationPanelBackgroundBrush" Color="#FFF0F2F5" />
          <SolidColorBrush x:Key="ComposerBackgroundBrush" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="AssistantMessageBackgroundBrush" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="UserMessageBackgroundBrush" Color="#FFDAECFF" />
          <SolidColorBrush x:Key="SystemMessageBackgroundBrush" Color="#FFEFF4F9" />
          <SolidColorBrush x:Key="MessageForegroundBrush" Color="#FF121821" />
          <SolidColorBrush x:Key="AuthorForegroundBrush" Color="#FF273447" />
          <SolidColorBrush x:Key="TimestampForegroundBrush" Color="#FF44505F" />
          <SolidColorBrush x:Key="MessageBorderBrush" Color="#FFD4DAE3" />
          <Thickness x:Key="ConversationContainerPadding">12</Thickness>
          <Thickness x:Key="ComposerContainerPadding">12 12 12 16</Thickness>
          <Thickness x:Key="StatusContainerPadding">8 6 12 8</Thickness>
          <Thickness x:Key="ConversationMessagePadding">12,8</Thickness>
          <CornerRadius x:Key="ConversationMessageCornerRadius">8</CornerRadius>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="ConversationPanelBackgroundBrush" Color="#FF2B2B2B" />
          <SolidColorBrush x:Key="ComposerBackgroundBrush" Color="#FF2F2F2F" />
          <SolidColorBrush x:Key="AssistantMessageBackgroundBrush" Color="#FF2F2F2F" />
          <SolidColorBrush x:Key="UserMessageBackgroundBrush" Color="#FF0F3D63" />
          <SolidColorBrush x:Key="SystemMessageBackgroundBrush" Color="#FF21313F" />
          <SolidColorBrush x:Key="MessageForegroundBrush" Color="#FFECECEC" />
          <SolidColorBrush x:Key="AuthorForegroundBrush" Color="#FFB4C5FF" />
          <SolidColorBrush x:Key="TimestampForegroundBrush" Color="#FF8EA5C6" />
          <SolidColorBrush x:Key="MessageBorderBrush" Color="#FF3A3F48" />
          <Thickness x:Key="ConversationContainerPadding">12</Thickness>
          <Thickness x:Key="ComposerContainerPadding">12 12 12 16</Thickness>
          <Thickness x:Key="StatusContainerPadding">8 6 12 8</Thickness>
          <Thickness x:Key="ConversationMessagePadding">12,8</Thickness>
          <CornerRadius x:Key="ConversationMessageCornerRadius">8</CornerRadius>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Default">
          <SolidColorBrush x:Key="ConversationPanelBackgroundBrush" Color="#FFF0F2F5" />
          <SolidColorBrush x:Key="ComposerBackgroundBrush" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="AssistantMessageBackgroundBrush" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="UserMessageBackgroundBrush" Color="#FFDAECFF" />
          <SolidColorBrush x:Key="SystemMessageBackgroundBrush" Color="#FFEFF4F9" />
          <SolidColorBrush x:Key="MessageForegroundBrush" Color="#FF121821" />
          <SolidColorBrush x:Key="AuthorForegroundBrush" Color="#FF273447" />
          <SolidColorBrush x:Key="TimestampForegroundBrush" Color="#FF44505F" />
          <SolidColorBrush x:Key="MessageBorderBrush" Color="#FFD4DAE3" />
          <Thickness x:Key="ConversationContainerPadding">12</Thickness>
          <Thickness x:Key="ComposerContainerPadding">12 12 12 16</Thickness>
          <Thickness x:Key="StatusContainerPadding">8 6 12 8</Thickness>
          <Thickness x:Key="ConversationMessagePadding">12,8</Thickness>
          <CornerRadius x:Key="ConversationMessageCornerRadius">8</CornerRadius>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <conv:HalfValueConverter x:Key="HalfValueConverter" />
      <conv:FractionValueConverter x:Key="TwoThirdsWidthConverter" Factor="0.66" />
      <conv:MessageRoleToBrushConverter x:Key="MessageRoleToBrushConverter" />
      <conv:MessageRoleToHorizontalAlignmentConverter x:Key="MessageRoleToHorizontalAlignmentConverter" />
      <conv:MessageRoleToThicknessConverter x:Key="MessageRoleToMarginConverter" />
      <conv:MessageRoleToFontStyleConverter x:Key="MessageRoleToFontStyleConverter" />
      <conv:MessageRoleToTextAlignmentConverter x:Key="MessageRoleToTextAlignmentConverter" />
      <conv:StringNotEmptyToBoolConverter x:Key="StringNotEmptyToBoolConverter" />
      <conv:FilePathToBitmapConverter x:Key="FilePathToBitmapConverter" />
      <conv:BooleanNegationConverter x:Key="BooleanNegationConverter" />
      <conv:MessageTimestampDisplayConverter x:Key="MessageTimestampDisplayConverter" />
      <conv:MessageTimestampTooltipConverter x:Key="MessageTimestampTooltipConverter" />

    </ResourceDictionary>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="Grid#ConversationLayout">
      <Setter Property="ColumnSpacing" Value="12" />
      <Setter Property="RowSpacing" Value="12" />
    </Style>
    <Style Selector="Grid#ConversationLayout.density-comfortable">
      <Setter Property="ColumnSpacing" Value="16" />
      <Setter Property="RowSpacing" Value="16" />
    </Style>
    <Style Selector="Grid#ConversationLayout.density-compact">
      <Setter Property="ColumnSpacing" Value="8" />
      <Setter Property="RowSpacing" Value="8" />
    </Style>
  </Window.Styles>

  <Design.DataContext>
    <vm:MainWindowViewModel />
  </Design.DataContext>

  <Grid ColumnDefinitions="260,*">
    <Border Grid.Column="0"
            Background="{DynamicResource ComposerBackgroundBrush}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16"
                    Spacing="16">
          <StackPanel Spacing="8">
            <TextBlock Text="Projects"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource AuthorForegroundBrush}" />
            <ListBox x:Name="ProjectsList"
                     SelectionChanged="ProjectsList_OnSelectionChanged">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="views:MainWindow+ProjectListItem">
                  <TextBlock Text="{Binding DisplayName}"
                             Margin="0,2"
                             TextTrimming="CharacterEllipsis"
                             Foreground="{DynamicResource MessageForegroundBrush}" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Button Content="+ New Project"
                    HorizontalAlignment="Left"
                    Click="AddProjectButton_OnClick" />
          </StackPanel>

          <Separator />

          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto"
                  VerticalAlignment="Center">
              <TextBlock Grid.Column="0"
                         Text="Project Files"
                         FontSize="16"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource AuthorForegroundBrush}" />
              <Button Grid.Column="1"
                      Content="+ Add file..."
                      IsEnabled="{Binding HasCustomProject}"
                      Click="AddProjectFileButton_OnClick" />
            </Grid>

            <Border Background="{DynamicResource ConversationPanelBackgroundBrush}"
                    CornerRadius="6"
                    Padding="8">
              <StackPanel>
                <TextBlock Text="No files uploaded yet."
                           Foreground="{DynamicResource AuthorForegroundBrush}"
                           FontSize="12"
                           IsVisible="{Binding HasProjectFiles, Converter={StaticResource BooleanNegationConverter}}" />
                <ListBox ItemsSource="{Binding ProjectFiles}"
                         IsVisible="{Binding HasProjectFiles}"
                         BorderThickness="0">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProjectFileItemViewModel">
                      <Grid ColumnDefinitions="*,Auto"
                            RowDefinitions="Auto,Auto"
                            ColumnSpacing="8"
                            Margin="0 4">
                        <TextBlock Grid.Column="0"
                                   Grid.Row="0"
                                   Text="{Binding Name}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource MessageForegroundBrush}" />
                        <TextBlock Grid.Column="0"
                                   Grid.Row="1"
                                   Text="{Binding SizeDescription}"
                                   FontSize="11"
                                   Foreground="{DynamicResource AuthorForegroundBrush}" />
                        <Button Grid.Column="1"
                                Grid.Row="0"
                                Grid.RowSpan="2"
                                Background="Transparent"
                                BorderBrush="{x:Null}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Click="DeleteProjectFileButton_OnClick"
                                Tag="{Binding}">
                          <Path Width="14"
                                Height="14"
                                Stretch="Uniform"
                                Fill="{DynamicResource AuthorForegroundBrush}"
                                Data="M4 2 L12 2 L12 4 L13 4 L13 5 L3 5 L3 4 L4 4 Z M5 5 L5 13 C5 13.5523 5.44772 14 6 14 L10 14 C10.5523 14 11 13.5523 11 13 L11 5 Z" />
                        </Button>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
            </Border>
          </StackPanel>

          <Separator />

          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto"
                  VerticalAlignment="Center">
              <TextBlock Grid.Column="0"
                         Text="Chat Sessions"
                         FontSize="16"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource AuthorForegroundBrush}" />
              <Button Grid.Column="1"
                      Content="+ New Chat"
                      Click="NewChatButton_OnClick" />
            </Grid>
            <ListBox x:Name="SessionsList"
                     SelectionChanged="SessionsList_OnSelectionChanged">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="views:MainWindow+ChatSessionListItem">
                  <StackPanel Orientation="Vertical"
                              Spacing="4">
                    <TextBlock Text="{Binding Title}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource MessageForegroundBrush}" />
                    <TextBlock Text="{Binding Subtitle}"
                               FontSize="11"
                               Foreground="{DynamicResource AuthorForegroundBrush}"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>

          <Separator />

          <Button Content="View Chat Debug Log"
                  HorizontalAlignment="Stretch"
                  Padding="12 8"
                  Click="OpenChatLogButton_OnClick"
                  IsEnabled="{Binding ChatLogPath, Converter={StaticResource StringNotEmptyToBoolConverter}}" />
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Grid x:Name="ConversationLayout"
          Grid.Column="1"
          Margin="16"
          RowDefinitions="Auto,*,Auto,Auto,Auto">
      <Grid Grid.Row="0"
            ColumnDefinitions="*,Auto,Auto"
            ColumnSpacing="12">
        <StackPanel Orientation="Vertical"
                    Spacing="2">
          <TextBlock FontSize="20"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource MessageForegroundBrush}"
                     Text="Foundry-9 AI Conversation"
                     HorizontalAlignment="Left" />
          <TextBlock FontSize="14"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource AuthorForegroundBrush}"
                     Text="{Binding CurrentProjectName}" />
          <StackPanel Orientation="Horizontal"
                      Spacing="6"
                      VerticalAlignment="Center">
            <Image Width="16"
                   Height="16"
                   Source="{Binding CurrentProviderIconPath, Converter={StaticResource FilePathToBitmapConverter}}"
                   ToolTip.Tip="{Binding CurrentProviderTooltip}"
                   Stretch="Uniform"
                   IsVisible="{Binding HasProviderIcon}" />
            <TextBlock FontSize="12"
                       Foreground="{DynamicResource AuthorForegroundBrush}"
                       Text="{Binding CurrentProvider}"
                       IsVisible="{Binding HasProviderIcon, Converter={StaticResource BooleanNegationConverter}}" />
            <TextBlock FontSize="12"
                       Foreground="{DynamicResource AuthorForegroundBrush}"
                       Text="{Binding CurrentModel}" />
          </StackPanel>
          <TextBlock FontSize="12"
                     Foreground="{DynamicResource AuthorForegroundBrush}"
                     TextWrapping="Wrap"
                     MaxHeight="80"
                     IsVisible="{Binding CurrentDescription, Converter={StaticResource StringNotEmptyToBoolConverter}}"
                     Text="{Binding CurrentDescription}" />
        </StackPanel>
        <Button Grid.Column="1"
                Content="Project Settings"
                HorizontalAlignment="Right"
                Padding="12,6"
                IsEnabled="{Binding HasCustomProject}"
                Click="ProjectSettingsButton_OnClick" />
        <Button Grid.Column="2"
                Content="Settings"
                HorizontalAlignment="Right"
                Padding="12,6"
                Click="SettingsButton_OnClick" />
      </Grid>

      <Border Grid.Row="1"
              Background="{DynamicResource ConversationPanelBackgroundBrush}"
              CornerRadius="6"
              Padding="{DynamicResource ConversationContainerPadding}">
        <ScrollViewer x:Name="ConversationScrollViewer"
                      VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Messages}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                <VirtualizingStackPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="model:Message">
                <Border Margin="{Binding Role, Converter={StaticResource MessageRoleToMarginConverter}}"
                        Padding="{DynamicResource ConversationMessagePadding}"
                        CornerRadius="{DynamicResource ConversationMessageCornerRadius}"
                        BorderBrush="{DynamicResource MessageBorderBrush}"
                        BorderThickness="1"
                        Background="{Binding Role, Converter={StaticResource MessageRoleToBrushConverter}}"
                        HorizontalAlignment="{Binding Role, Converter={StaticResource MessageRoleToHorizontalAlignmentConverter}}"
                        MaxWidth="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Converter={StaticResource TwoThirdsWidthConverter}}">
                  <StackPanel Spacing="4">
                    <TextBlock Text="{Binding Author}"
                               FontWeight="SemiBold"
                               FontStyle="{Binding Role, Converter={StaticResource MessageRoleToFontStyleConverter}}"
                               Foreground="{DynamicResource AuthorForegroundBrush}"
                               TextAlignment="{Binding Role, Converter={StaticResource MessageRoleToTextAlignmentConverter}}" />
                    <TextBlock Text="{Binding Content}"
                               TextWrapping="Wrap"
                               FontStyle="{Binding Role, Converter={StaticResource MessageRoleToFontStyleConverter}}"
                               Foreground="{DynamicResource MessageForegroundBrush}"
                               TextAlignment="{Binding Role, Converter={StaticResource MessageRoleToTextAlignmentConverter}}" />
                    <TextBlock Text="{Binding Timestamp, Converter={StaticResource MessageTimestampDisplayConverter}}"
                               FontSize="11"
                               Foreground="{DynamicResource TimestampForegroundBrush}"
                               TextAlignment="{Binding Role, Converter={StaticResource MessageRoleToTextAlignmentConverter}}"
                               ToolTip.Tip="{Binding Timestamp, Converter={StaticResource MessageTimestampTooltipConverter}}"
                               Opacity="0.85" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>

      <Border Grid.Row="2"
              Background="{DynamicResource ComposerBackgroundBrush}"
              CornerRadius="6"
              Padding="{DynamicResource ComposerContainerPadding}">
        <Grid ColumnDefinitions="*,Auto"
              RowDefinitions="Auto,Auto"
              ColumnSpacing="12"
              RowSpacing="8">
          <StackPanel Grid.Row="0"
                      Grid.ColumnSpan="2"
                      Orientation="Horizontal"
                      Spacing="8"
                      VerticalAlignment="Center"
                      IsVisible="{Binding IsResponding}">
            <ProgressBar Width="80"
                         Height="6"
                         IsIndeterminate="True"
                         VerticalAlignment="Center" />
            <TextBlock Text="Assistant is thinking..."
                       Foreground="{DynamicResource AuthorForegroundBrush}"
                       VerticalAlignment="Center" />
          </StackPanel>

          <TextBox x:Name="ComposerTextBox"
                   Grid.Row="1"
                   Grid.Column="0"
                   Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}"
                   TextWrapping="Wrap"
                   AcceptsReturn="True"
                   MinLines="3"
                   IsEnabled="{Binding IsResponding, Converter={StaticResource BooleanNegationConverter}}"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   Watermark="Type your message..."
                   MaxHeight="{Binding Bounds.Height, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource HalfValueConverter}}" />

          <Grid Grid.Row="1"
                Grid.Column="1"
                HorizontalAlignment="Right">
            <Button Content="Send"
                    Padding="20 12"
                    Command="{Binding SendCommand}"
                    IsVisible="{Binding IsResponding, Converter={StaticResource BooleanNegationConverter}}" />
            <Button Content="Stop"
                    Padding="20 12"
                    Command="{Binding StopCommand}"
                    IsVisible="{Binding IsResponding}" />
          </Grid>
        </Grid>
      </Border>

      <Border Grid.Row="3"
              Background="{DynamicResource ComposerBackgroundBrush}"
              CornerRadius="6"
              Padding="{DynamicResource StatusContainerPadding}">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="Auto,*,Auto"
                ColumnSpacing="12">
            <StackPanel Orientation="Horizontal"
                        Spacing="8">
              <TextBlock Text="Background Processes"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource AuthorForegroundBrush}" />
              <TextBlock Text="{Binding BackgroundProcesses.Count, StringFormat={}{0} active}"
                         Foreground="{DynamicResource TimestampForegroundBrush}"
                         FontSize="12" />
            </StackPanel>
          </Grid>
          <ItemsControl ItemsSource="{Binding BackgroundProcesses}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:BackgroundProcessItemViewModel">
                <Border Background="{DynamicResource ConversationPanelBackgroundBrush}"
                        CornerRadius="4"
                        Padding="8"
                        Margin="0,0,0,6"
                        BorderBrush="{DynamicResource MessageBorderBrush}"
                        BorderThickness="1">
                  <Grid ColumnDefinitions="Auto,*,Auto"
                        ColumnSpacing="12"
                        RowDefinitions="Auto,Auto"
                        RowSpacing="4">
                    <Border Grid.RowSpan="2"
                            Width="28"
                            Height="28"
                            CornerRadius="4"
                            Background="{DynamicResource ComposerBackgroundBrush}"
                            BorderBrush="{DynamicResource MessageBorderBrush}"
                            BorderThickness="1"
                            ToolTip.Tip="{Binding CategoryDescription}">
                      <TextBlock Text="{Binding Icon}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource AuthorForegroundBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1"
                                Orientation="Vertical"
                                Spacing="2">
                      <TextBlock Text="{Binding DisplayName}"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource MessageForegroundBrush}" />
                      <TextBlock Text="{Binding StatusMessage}"
                                 Foreground="{DynamicResource TimestampForegroundBrush}"
                                 FontSize="12"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="2"
                                Orientation="Vertical"
                                Spacing="2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                      <TextBlock Text="{Binding StateText}"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource AuthorForegroundBrush}"
                                 HorizontalAlignment="Right" />
                      <TextBlock Text="{Binding StartedAt, StringFormat={}{0:G}}"
                                 FontSize="11"
                                 Foreground="{DynamicResource TimestampForegroundBrush}"
                                 HorizontalAlignment="Right" />
                    </StackPanel>
                    <Button Grid.Row="1"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Content="Open Console"
                            Command="{Binding OpenTerminalCommand}"
                            HorizontalAlignment="Right"
                            Padding="12 6" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>


      <Border Grid.Row="5"
              Background="{DynamicResource ComposerBackgroundBrush}"
              CornerRadius="6"
              Padding="{DynamicResource StatusContainerPadding}">
        <Grid ColumnDefinitions="*,Auto"
              ColumnSpacing="12">
          <StackPanel Orientation="Vertical"
                      Spacing="2">
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{DynamicResource AuthorForegroundBrush}"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding ErrorSummary}"
                       Foreground="#FFD95B5B"
                       FontStyle="Italic"
                       TextWrapping="Wrap"
                       IsVisible="{Binding ErrorSummary, Converter={StaticResource StringNotEmptyToBoolConverter}}" />
          </StackPanel>
          <Button Grid.Column="1"
                  Content="Retry"
                  Padding="16 8"
                  Command="{Binding RetryCommand}"
                  IsVisible="{Binding CanRetry}" />
        </Grid>
      </Border>
    </Grid>
  </Grid>

</Window>
